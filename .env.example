# Copy to .env and adjust for production

SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///instance/school.db

# Optional: protect hardware RFID POST /rfid_scan
RFID_API_KEY=

# Optional: email alerts (in-app notifications always work)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@school.edu
